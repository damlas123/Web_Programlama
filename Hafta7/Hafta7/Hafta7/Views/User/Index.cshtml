@model User
@if (TempData["Hata"] is not null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}
<div class="row">
    <div class="col-md-4">
     <form asp-action="LoginUser">
         <div asp-validation-summary="ModelOnly" class="text-danger"></div>
         <div class="form-group">
            <label asp-for="username" class="control-label">Kullanıcı Adı</label>
            <input asp-for="username" class="form-control" />
            <span asp-validation-for="username" class="text-danger"></span>
         </div>
         <div class="form-group">
            <label asp-for="password" class="control-label">Parola</label>
            <input asp-for="password" class="form-control" />
             <span asp-validation-for="password" class="text-danger"></span>
         </div>
         <div class="form-group">
            <label asp-for="usercolorsettings" class="control-label">Renk Seçimi</label>
            <input asp-for="usercolorsettings" class="form-control" />
            <span asp-validation-for="usercolorsettings" class="text-danger"></span>
         </div>
         <div class="form-group">
            <input type="submit" value="Giriş Yap" class="btn btn-primary" />
         </div>
     </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");//await demek bu işlemin bitmesini bekle demek. await kullanmazsak sayfa yüklenmeden önce validation çalışır ve hata verir.

    }
}